{
  extends: [
    'config:recommended',
  ],
  schedule: 'before 9am on the first day of the month',
  timezone: 'America/Detroit',
  vulnerabilityAlerts: {
    labels: [
      'security',
    ],
    schedule: 'at any time',
  },
  labels: [
    'compose',
  ],
  ignoreUnstable: true,
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      pinDigests: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: true,
    },
  ],
}
